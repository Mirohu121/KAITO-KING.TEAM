# =============================================================================
# Unity + Git hygiene (keep repo lean; avoid Git LFS / large-binary pressure)
# =============================================================================
# Local planning docs (not versioned)
/docs/

# -----------------------------------------------------------------------------
# Unity generated / cache (never commit)
# -----------------------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ServerData/
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Crash dumps / profiling
*.stackdump
*.dmp
/[Pp]rofiler/

# -----------------------------------------------------------------------------
# IDE / OS noise
# -----------------------------------------------------------------------------
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.DotSettings.user
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Gradle / Android local
.gradle/
*.iml
local.properties

# -----------------------------------------------------------------------------
# Auto-generated solution / project files (Unity regenerates these)
# -----------------------------------------------------------------------------
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Rider / JetBrains Unity plugin (auto)
/[Aa]ssets/Plugins/Editor/JetBrains*

# -----------------------------------------------------------------------------
# Builds & packages (large; keep out of git)
# -----------------------------------------------------------------------------
*.apk
*.aab
*.app
*.exe
*.dll
!/[Aa]ssets/**/*.dll
*.so
*.dylib
*.unitypackage
*.unitypackage.meta
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# -----------------------------------------------------------------------------
# Large media (use intentional commits / LFS later if needed)
# Keep prototype on primitives; do not silently commit heavy binaries.
# -----------------------------------------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.ogg
*.flac
*.aiff
*.psd
*.psb
*.tif
*.tiff
*.exr
*.hdr
*.tga
*.blend
*.blend1
*.blend1.meta
*.mb
*.ma
*.max
*.c4d
*.abc
*.obj
!/[Aa]ssets/**/*.obj.meta

# Raw captures / photo dumps often land in repo by mistake
*.CR2
*.NEF
*.ARW

# -----------------------------------------------------------------------------
# Addressables / Streaming generated
# -----------------------------------------------------------------------------
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Play Mode tests / dependency cache
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# -----------------------------------------------------------------------------
# TextMeshPro (optional defaults can be huge; ignore common TMP extras if added)
# -----------------------------------------------------------------------------
/[Aa]ssets/TextMesh Pro/Examples*
/[Aa]ssets/TextMesh Pro/Documentation*
/[Aa]ssets/TextMesh Pro/Fonts*

# -----------------------------------------------------------------------------
# Collab / Plastic / leftover VCS
# -----------------------------------------------------------------------------
.collabignore
/[Aa]ssets/Plugins/[Cc]ollab*
*.private.0
*.private.1

# -----------------------------------------------------------------------------
# Explicit: do not track Git LFS pointer dumps or local LFS objects
# -----------------------------------------------------------------------------
/.lfs/
**/*.lfs.pointer
